# ===== Evolution API =====
AUTHENTICATION_API_KEY=SUBSTITUA_POR_UMA_CHAVE_FORTE
SERVER_PORT=8080
SERVER_URL=http://localhost:8080

# ===== Banco de dados (MySQL) =====
DATABASE_ENABLED=true
DATABASE_PROVIDER=mysql
DATABASE_CONNECTION_URI=mysql://evolution:SUBSTITUA_A_SENHA@evolution-mysql:3306/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution_api
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

MYSQL_DATABASE=evolution
MYSQL_USERNAME=evolution
MYSQL_PASSWORD=SUBSTITUA_A_SENHA
MYSQL_ROOT_PASSWORD=SUBSTITUA_A_SENHA_ROOT

# Alternativa PostgreSQL (troque o servico evolution-mysql no docker-compose.yml):
# DATABASE_PROVIDER=postgresql
# DATABASE_CONNECTION_URI=postgresql://evolution:SUBSTITUA_A_SENHA@evolution-postgres:5432/evolution?schema=evolution_api
# POSTGRES_DATABASE=evolution
# POSTGRES_USERNAME=evolution
# POSTGRES_PASSWORD=SUBSTITUA_A_SENHA

# ===== Cache =====
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=whatsapp-cardapio
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ===== Webhook global (envia mensagens para o n8n) =====
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=http://n8n:5678/webhook/cardapio-whatsapp
WEBHOOK_EVENTS_MESSAGES_UPSERT=true

# ===== Bot do cardapio =====
# Numero do dono no formato DDI+DDD+numero, somente digitos.
# Se ficar vazio, o bot aceita mensagens de qualquer numero (bom para testes).
OWNER_NUMBER=
RESTAURANT_NAME=Meu Restaurante
